---
---
<!-- Sección About Me -->
<section id="about" class="py-24 px-6 md:px-[10%]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

        <!-- Columna Texto -->
        <div>
            <p class="lang-text text-primary font-bold tracking-[2px] text-[13px] mb-2 uppercase" data-key="about_subtitle">WHO I AM</p>
            <h2 class="lang-text text-[40px] font-bold mb-6 leading-tight" data-key="about_title">About Me</h2>
            <p class="lang-text bio-text text-secondary leading-relaxed mb-8 text-[15px]" data-key="about_bio">
                Hello! I'm Pablo Diaz, a multidisciplinary creative passionate about the intersection of design and technology. With a sharp eye for detail and a focus on user experience, I transform complex ideas into elegant digital solutions. Whether it's crafting a pixel-perfect interface or coding a robust website, I give 100% to every project.
            </p>

            <div class="space-y-4 mb-8">
                <div class="flex items-center">
                    <span class="lang-text w-20 font-semibold text-white" data-key="lbl_name">Name:</span>
                    <span class="text-secondary">Pablo Diaz</span>
                </div>
                <div class="flex items-center">
                    <span class="lang-text w-20 font-semibold text-white" data-key="lbl_from">From:</span>
                    <span class="text-secondary">Santo Domingo, DR</span>
                </div>
                <div class="flex items-center">
                    <span class="lang-text w-20 font-semibold text-white" data-key="lbl_email">Email:</span>
                    <span class="text-secondary">
                        <a href="mailto:pablomigueldiazvizcaino@gmail.com" class="hover:text-primary transition-colors">pablomigueldiazvizcaino@gmail.com</a>
                    </span>
                </div>
            </div>
        </div>

        <!-- Columna Skills -->
        <div>
            <h3 class="lang-text text-2xl mb-8 relative pb-2 inline-block after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-10 after:h-[3px] after:bg-primary" data-key="skills_title">My Skills & Tools</h3>

            <!-- Graphic Design -->
            <div class="mb-8">
                <h4 class="lang-text text-base text-white font-medium mb-4" data-key="cat_design">Graphic & UI Design</h4>
                <div class="flex flex-wrap gap-3">
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fab fa-figma text-primary group-hover:text-white transition-colors duration-300"></i> Figma
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fas fa-pen-nib text-primary group-hover:text-white transition-colors duration-300"></i> Photoshop
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fas fa-vector-square text-primary group-hover:text-white transition-colors duration-300"></i> Illustrator
                    </span>
                </div>
            </div>

            <!-- Web Development ACTUALIZADO -->
            <div class="mb-8">
                <h4 class="lang-text text-base text-white font-medium mb-4" data-key="cat_dev">Web Development</h4>
                <div class="flex flex-wrap gap-3">
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fab fa-react text-primary group-hover:text-white transition-colors duration-300"></i> React
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fas fa-rocket text-primary group-hover:text-white transition-colors duration-300"></i> Astro
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fab fa-js text-primary group-hover:text-white transition-colors duration-300"></i> JavaScript
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fab fa-html5 text-primary group-hover:text-white transition-colors duration-300"></i> HTML5 & CSS3
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fab fa-wordpress text-primary group-hover:text-white transition-colors duration-300"></i> WordPress / Elementor
                    </span>
                </div>
            </div>

            <!-- Photo & Video -->
            <div>
                <h4 class="lang-text text-base text-white font-medium mb-4" data-key="cat_media">Photography & Video</h4>
                <div class="flex flex-wrap gap-3">
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fas fa-camera-retro text-primary group-hover:text-white transition-colors duration-300"></i> Lightroom
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fas fa-video text-primary group-hover:text-white transition-colors duration-300"></i> Premiere
                    </span>
                    <span class="group bg-white/5 px-4 py-2.5 rounded text-[13px] text-secondary border-l-[3px] border-primary flex items-center gap-2 hover:bg-primary hover:text-white hover:translate-x-1 transition-all duration-300 cursor-default">
                        <i class="fas fa-magic text-primary group-hover:text-white transition-colors duration-300"></i> After Effects
                    </span>
                </div>
            </div>

        </div>
    </div>
</section>
