---
---
<!-- Sección Hero -->
<section id="home" class="min-h-screen pt-32 pb-16 px-6 md:px-[8%] flex items-center justify-center">
    <div class="w-full max-w-[1200px] flex flex-col-reverse md:flex-row items-center justify-between gap-12">

        <!-- Texto Hero -->
        <div class="w-full md:w-1/2 z-10 text-center md:text-left">
            <span class="greeting lang-text block text-lg font-semibold tracking-[3px] text-secondary mb-4" data-key="greeting">HI THERE!</span>

            <h1 class="text-5xl md:text-[65px] leading-[1.1] font-bold mb-6">
                <span class="lang-text" data-key="im">I'M</span> <span class="text-primary">PABLO</span>
            </h1>

            <div class="roles inline-block bg-primary text-white px-5 py-2 font-semibold text-sm mb-8 skew-x-[-10deg]">
                <span class="block skew-x-[10deg]">
                    Web Designer // UX UI Designer // Photographer
                </span>
            </div>

            <p class="description lang-text text-secondary leading-loose mb-10 text-base max-w-[90%] mx-auto md:mx-0" data-key="description">
                I'm a designer based in Dominican Republic, specialized in creating visual experiences and functional interfaces. Passionate about detail and aesthetics.
            </p>

            <div class="flex gap-5 justify-center md:justify-start mb-10">
                <a href="#contact" class="lang-text btn-primary px-9 py-3.5 rounded-full font-semibold text-sm bg-primary text-white border-2 border-primary shadow-glow hover:bg-transparent hover:text-primary hover:shadow-glow-hover hover:-translate-y-1 transition-all duration-300" data-key="btn_hire">HIRE ME</a>
                <a href="#portfolio" class="lang-text btn-secondary px-9 py-3.5 rounded-full font-semibold text-sm bg-transparent text-white border-2 border-white/20 hover:border-primary hover:text-primary transition-all duration-300" data-key="nav_portfolio">PORTFOLIO</a>
            </div>

            <div class="flex gap-6 justify-center md:justify-start text-xl text-secondary">
                <a href="https://www.linkedin.com/in/pablo-diaz-designer/" target="_blank" rel="noopener noreferrer" class="hover:text-primary hover:-translate-y-1 transition-all duration-300" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
                <a href="https://www.behance.net/pablodiaz1920" target="_blank" rel="noopener noreferrer" class="hover:text-primary hover:-translate-y-1 transition-all duration-300" aria-label="Behance">
                    <i class="fab fa-behance"></i>
                </a>
            </div>
        </div>

        <!-- Imagen Hero -->
        <div class="w-full md:w-[400px] h-[380px] md:h-[500px] relative flex justify-center items-center group shrink-0">
            <img src="/Pablo Diaz2.jpeg" alt="Pablo Diaz" class="w-full h-full object-cover rounded-lg grayscale group-hover:grayscale-0 transition-all duration-500 z-10 relative">
            <div class="absolute w-full h-full border-[5px] border-primary top-6 -right-6 z-0 transition-all duration-300 group-hover:top-4 group-hover:-right-4"></div>
        </div>

    </div>
</section>
