---
---
<!-- Sección Contacto -->
<section id="contact" class="py-24 px-6 md:px-[10%]">
    <div class="text-center mb-12">
        <p class="lang-text text-primary font-bold tracking-[2px] text-[13px] uppercase" data-key="contact_subtitle">GET IN TOUCH</p>
        <h2 class="lang-text text-[40px] font-bold mt-2" data-key="contact_title">Contact Me</h2>
    </div>

    <div class="flex flex-col items-center text-center gap-12 max-w-[900px] mx-auto">
        <p class="lang-text contact-message text-lg text-secondary leading-loose max-w-[700px]" data-key="contact_msg">
            I'm always interested in hearing about new projects and opportunities. Whether you have a question or just want to say hi, feel free to reach out. Let's create something amazing together!
        </p>

        <!-- Tarjetas Info -->
        <div class="flex flex-wrap justify-center gap-8 w-full">
            <div class="flex-1 min-w-[250px] bg-white/5 border border-white/5 p-8 rounded-2xl flex flex-col items-center hover:-translate-y-2 hover:border-primary hover:bg-primary/5 transition-all duration-300 group">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
                    <i class="fas fa-envelope text-3xl text-primary"></i>
                </div>
                <h4 class="lang-text text-lg font-bold text-white mb-2" data-key="info_email_title">Email</h4>
                <p class="text-secondary text-[15px] break-all">
                    <a href="mailto:pablomigueldiazvizcaino@gmail.com" class="hover:text-primary transition-colors">pablomigueldiazvizcaino@gmail.com</a>
                </p>
            </div>

            <div class="flex-1 min-w-[250px] bg-white/5 border border-white/5 p-8 rounded-2xl flex flex-col items-center hover:-translate-y-2 hover:border-primary hover:bg-primary/5 transition-all duration-300 group">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
                    <i class="fas fa-phone text-3xl text-primary"></i>
                </div>
                <h4 class="lang-text text-lg font-bold text-white mb-2" data-key="info_phone_title">Phone</h4>
                <p class="text-secondary text-[15px]">
                    <a href="tel:+1-809-779-5503" class="hover:text-primary transition-colors">+1 (809) 779-5503</a>
                </p>
            </div>

            <div class="flex-1 min-w-[250px] bg-white/5 border border-white/5 p-8 rounded-2xl flex flex-col items-center hover:-translate-y-2 hover:border-primary hover:bg-primary/5 transition-all duration-300 group">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
                    <i class="fas fa-map-marker-alt text-3xl text-primary"></i>
                </div>
                <h4 class="lang-text text-lg font-bold text-white mb-2" data-key="info_loc_title">Location</h4>
                <p class="text-secondary text-[15px]">Santo Domingo, DR</p>
            </div>
        </div>

        <!-- Botones Sociales Grandes -->
        <div class="w-full">
            <h3 class="lang-text text-white mb-6 font-medium text-lg" data-key="social_title">Connect on Social Media</h3>
            <div class="flex flex-wrap justify-center gap-5">
                <a href="https://www.linkedin.com/in/pablo-diaz-designer/" target="_blank" rel="noopener noreferrer" class="px-9 py-3.5 border-2 border-primary rounded-full text-white font-semibold flex items-center gap-3 hover:bg-primary hover:shadow-glow hover:-translate-y-1 transition-all duration-300">
                    <i class="fab fa-linkedin-in text-xl"></i> LinkedIn
                </a>
                <a href="https://www.behance.net/pablodiaz1920" target="_blank" rel="noopener noreferrer" class="px-9 py-3.5 border-2 border-primary rounded-full text-white font-semibold flex items-center gap-3 hover:bg-primary hover:shadow-glow hover:-translate-y-1 transition-all duration-300">
                    <i class="fab fa-behance text-xl"></i> Behance
                </a>
            </div>
        </div>
    </div>
</section>
